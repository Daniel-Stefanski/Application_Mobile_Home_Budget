<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Ustawienia aplikacji"
            android:textColor="?android:textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <include
            android:id="@+id/headerAccount"
            layout="@layout/item_settings_header" />

        <LinearLayout
            android:id="@+id/sectionAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editTextName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/shape_search_border"
                    android:hint="Imię lub Nick"
                    android:inputType="textPersonName"
                    android:padding="12dp" />

                <Space
                    android:layout_width="32dp"
                    android:layout_height="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editTextEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/shape_search_border"
                    android:hint="Email"
                    android:inputType="textEmailAddress"
                    android:padding="12dp" />

                <Space
                    android:layout_width="32dp"
                    android:layout_height="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editTextOldPassword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/shape_search_border"
                    android:hint="Stare hasło"
                    android:inputType="textPassword"
                    android:padding="12dp" />

                <Space
                    android:layout_width="32dp"
                    android:layout_height="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editTextNewPassword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/shape_search_border"
                    android:hint="Nowe hasło"
                    android:inputType="textPassword"
                    android:padding="12dp" />

                <ImageView
                    android:id="@+id/imagePasswordInfoSettings"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Wymagania hasła"
                    android:src="@drawable/ic_info"
                    app:tint="#1976D2" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/checkboxShowPasswordSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Pokaż/Ukryj hasła"
                android:textSize="14sp" />

            <Button
                android:id="@+id/buttonSaveAccountChanges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/buttonBackground"
                android:text="Zapisz zmiany"
                android:textColor="@color/buttonText" />

            <Button
                android:id="@+id/buttonDeleteAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/buttonDangerBackground"
                android:text="Usuń konto"
                android:textColor="@color/buttonDangerText" />
        </LinearLayout>

        <include
            android:id="@+id/headerCategories"
            layout="@layout/item_settings_header" />

        <LinearLayout
            android:id="@+id/sectionCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="Tutaj użytkownik będzie mógł edytować lub dodać kategorie" />
        </LinearLayout>

        <include
            android:id="@+id/headerPeople"
            layout="@layout/item_settings_header" />

        <LinearLayout
            android:id="@+id/sectionPeople"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="Tutaj pojawi się lista fikcyjnych osób" />
        </LinearLayout>

        <include
            android:id="@+id/headerTheme"
            layout="@layout/item_settings_header" />

        <LinearLayout
            android:id="@+id/sectionTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/rowLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/shape_search_border"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <RadioButton
                    android:id="@+id/radioLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="☀️"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Tryb jasny"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/shape_search_border"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <RadioButton
                    android:id="@+id/radioDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="🌙"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Tryb ciemny"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/shape_search_border"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <RadioButton
                    android:id="@+id/radioSystem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="⚙️"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Automatyczny (zgodny z systemem)"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <include
            android:id="@+id/headerPreferences"
            layout="@layout/item_settings_header" />

        <LinearLayout
            android:id="@+id/sectionPreferences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/checkboxNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Powiadomienia systemowe"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textExactAlarmInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Aktualne godziny powiadomień:&#10;• Budżet: 19:00&#10;• Rachunki planowane: 08:00&#10;• Cele oszczędnościowe: 08:00"
                android:textColor="?android:textColorPrimary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textExactAlarmStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Dokładne alarmy pomagają ograniczyć opóźnienia powiadomień na niektórych telefonach."
                android:textColor="#666666"
                android:textSize="13sp" />

            <Button
                android:id="@+id/buttonExactAlarmSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/buttonBackground"
                android:text="Ustaw dokładne alarmy"
                android:textColor="@color/buttonText" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Domyślna kategoria"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerDefaultCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/shape_search_border" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Domyślna metoda płatności"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerDefaultPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_search_border" />

            <Button
                android:id="@+id/buttonResetData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/buttonBackground"
                android:text="Reset danych"
                android:textColor="@color/buttonText" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonBackToMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/buttonBackground"
            android:text="Powrót do ekranu głównego"
            android:textColor="@color/buttonText" />

        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/buttonDangerBackground"
            android:text="Wyloguj się"
            android:textColor="@color/buttonDangerText" />
    </LinearLayout>
</ScrollView>
